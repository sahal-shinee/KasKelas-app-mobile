<?xml version="1.0" encoding="utf-8"?>
<!--
    item_notifikasi.xml
    Desain mengikuti mockup: ikon tipe (kotak warna), judul bold, isi truncated,
    pengirim kecil. Unread ditandai dengan strip biru kiri + background lebih terang.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_notifikasi"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="top">

        <!-- Indikator unread strip kiri (diimplementasi via background di Java) -->

        <!-- Ikon tipe notifikasi (kotak rounded dengan ikon) -->
        <FrameLayout
            android:id="@+id/fl_icon_container"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_notif_icon_tagihan">

            <ImageView
                android:id="@+id/iv_tipe_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_tagihan"
                app:tint="@android:color/white" />

        </FrameLayout>

        <!-- Konten teks -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Baris atas: tipe label + waktu relatif -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tv_tipe_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAGIHAN"
                    android:textColor="@color/color_error"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_waktu_relatif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10:45 AM"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Judul notifikasi -->
            <TextView
                android:id="@+id/tv_judul"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tagihan Baru: Tes"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="4dp" />

            <!-- Isi notifikasi (truncated) -->
            <TextView
                android:id="@+id/tv_isi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ada tagihan baru yang perlu diselesaikan..."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="6dp" />

            <!-- Pengirim -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_person"
                    android:layout_marginEnd="4dp"
                    app:tint="@color/text_hint" />

                <TextView
                    android:id="@+id/tv_pengirim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dari: Bendahara Kelas"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Tombol hapus (muncul saat long-press / selalu tampil kecil di pojok) -->
        <ImageButton
            android:id="@+id/btn_hapus_item"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="-2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="Hapus"
            app:tint="@color/text_hint"
            android:alpha="0.6"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>