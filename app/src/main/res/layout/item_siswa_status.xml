<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="10dp">

    <!-- Nama siswa -->
    <TextView android:id="@+id/tv_nama"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/text_primary" android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Status + Tagihan + Tombol -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <!-- Dot status -->
        <TextView android:id="@+id/tv_status_dot"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="●" android:textSize="10sp" android:layout_marginEnd="4dp" />

        <!-- Label status -->
        <com.google.android.material.chip.Chip android:id="@+id/chip_status"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="10sp" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <!-- Nominal tagihan -->
        <TextView android:id="@+id/tv_tagihan"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_secondary" android:textSize="11sp"
            android:layout_marginEnd="8dp" />

        <!-- Tombol Tandai Lunas / Batalkan -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_ubah_status"
            android:layout_width="wrap_content" android:layout_height="30dp"
            android:textSize="10sp" app:cornerRadius="8dp"
            app:backgroundTint="@color/color_primary" />
    </LinearLayout>

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/bg_primary" android:layout_marginTop="10dp" />

    <!-- Hidden fields untuk data -->
    <TextView android:id="@+id/tv_nis" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:visibility="gone" />
    <TextView android:id="@+id/tv_initial" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:visibility="gone" />
    <TextView android:id="@+id/tv_tanggal_bayar" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:visibility="gone" />

</LinearLayout>
